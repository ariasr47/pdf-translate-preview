{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional translation project brief (documentation contract)",
  "type": "object",
  "required": [
    "source",
    "target_locale",
    "audience",
    "purpose",
    "review_requirements"
  ],
  "properties": {
    "source": {
      "type": "object",
      "required": [
        "identity",
        "sha256"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "target_locale": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "register": {
      "type": "string",
      "minLength": 1
    },
    "protected_identifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "terminology_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "content_policy": {
      "enum": [
        "preserve-report",
        "refuse-active"
      ]
    },
    "retention": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
